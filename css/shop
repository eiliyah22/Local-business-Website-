body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
main {
  flex: 1;
}
.main-nav a[aria-current="page"] {
  border-color: var(--berry);
}
.shop-intro {
  max-width: 1100px;
  margin: 0 auto;
  padding: 56px 32px 8px;
}
.shop-intro h1 {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(2.6rem, 7vw, 5rem);
  line-height: 0.9;
  letter-spacing: -0.04em;
  text-transform: uppercase;
}
.shop-intro p {
  max-width: 46ch;
  margin-top: 18px;
  font-size: 1.15rem;
  line-height: 1.6;
}
.shop-products {
  max-width: 1100px;
  margin: 0 auto;
  padding: 32px 32px 80px;
}
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 36px;
}
.filter {
  padding: 9px 20px;
  background: var(--white);
  color: var(--choc);
  border: 2px solid var(--choc);
  border-radius: 999px;
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
}
.filter:hover {
  border-color: var(--berry);
}
.filter.active {
  background: var(--choc);
  color: var(--cream);
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 36px;
}
.product {
  display: flex;
  flex-direction: column;
  background: var(--white);
  border: var(--line);
  border-radius: 24px;
  box-shadow: 8px 8px 0 var(--choc);
  overflow: hidden;
}
.product[hidden] {
  display: none;
}
.product-body {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  padding: 24px 26px 26px;
}
.product-body h3 {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 1.4rem;
  line-height: 1.1;
  letter-spacing: -0.01em;
  text-transform: uppercase;
}
.product-body p {
  margin-top: 10px;
  font-size: 1rem;
  line-height: 1.45;
}
.product-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  padding-top: 22px;
}
.price {
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 1.25rem;
  white-space: nowrap;
}
.btn-small {
  padding: 11px 20px;
  background: var(--berry);
  color: #F9D0CE;
  font-size: 0.85rem;
  cursor: pointer;
}
.cookie {
  display: grid;
  place-items: center;
  aspect-ratio: 4 / 3;
  background: var(--cream);
  border-bottom: var(--line);
}
.cookie::before {
  content: "";
  width: 56%;
  aspect-ratio: 1;
  border: var(--line);
  border-radius: 50%;
  box-shadow: 5px 6px 0 var(--choc);
  background:
    radial-gradient(circle at 28% 32%, var(--chip) 0 6%, transparent 6.5%),
    radial-gradient(circle at 64% 24%, var(--chip) 0 5%, transparent 5.5%),
    radial-gradient(circle at 74% 58%, var(--chip) 0 6.5%, transparent 7%),
    radial-gradient(circle at 36% 70%, var(--chip) 0 5.5%, transparent 6%),
    radial-gradient(circle at 52% 47%, var(--chip) 0 4.5%, transparent 5%),
    var(--base);
}
.c-choc  { --base: #d9a566; --chip: #4a2c26; }
.c-dark  { --base: #6b3a2e; --chip: #2b1612; }
.c-oat   { --base: #d8b98a; --chip: #6e3a4a; }
.c-pb    { --base: #d99a4e; --chip: #b8772f; }
.c-white { --base: #ecd3a0; --chip: #fbf3e4; }
.c-red   { --base: #a8324a; --chip: #f6e7da; }

.boxes {
  background: var(--gold);
  border-top: var(--line);
  border-bottom: var(--line);
}
.boxes-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 56px 32px 64px;
}
.boxes h2 {
  margin-bottom: 28px;
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(2rem, 5vw, 3rem);
  line-height: 1;
  letter-spacing: -0.03em;
  text-transform: uppercase;
}
.box-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28px;
}
.box {
  padding: 26px;
  background: var(--white);
  border: var(--line);
  border-radius: 20px;
  box-shadow: 6px 6px 0 var(--choc);
}
.box h3 {
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 1.15rem;
}
.box-price {
  margin: 6px 0 10px;
  font-family: var(--font-display);
  font-size: 2rem;
  line-height: 1;
  color: var(--berry);
}


@media (max-width: 900px) {
  .site-header {
    height: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 12px;
    padding: 12px 16px;
  }
  .logo {
    font-size: 1.5rem;
  }
  .main-nav {
    display: flex;
    order: 3;
    width: 100%;
    justify-content: center;
    gap: 24px;
  }
  .main-nav a {
    font-size: 0.8rem;
  }
  .shop-intro {
    padding: 40px 20px 0;
  }
  .shop-products {
    padding: 28px 20px 56px;
  }
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .boxes-inner {
    padding: 44px 20px 52px;
  }
  .box-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 600px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
  .product,
  .box {
    box-shadow: 6px 6px 0 var(--choc);
  }
}
@media (prefers-reduced-motion: reduce) {
  .filter {
    transition: none;
  }
}